{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地工具箱",
  "version": "0.1.6",
  "identifier": "com.local-toolbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "本地工具箱",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "bin/yt-dlp.exe": "yt-dlp.exe",
      "bin/ffmpeg.exe": "ffmpeg.exe",
      "bin/node.exe": "node.exe",
      "bin/deno.exe": "deno.exe",
      "bin/bgutil": "bgutil"
    },
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
